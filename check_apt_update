#!/bin/bash

# Get the list of upgradable packages
if ! apt_output=$(LC_ALL=C apt list --upgradable 2>/dev/null); then
    printf 'APT UNKNOWN - Unable to list upgradable packages\n'
    exit 3
fi

PACKAGE_LIST=$(printf '%s\n' "$apt_output" | awk -F/ '/^[^[:space:]\/]+\/[^[:space:]]+[[:space:]]/ { print $1 }')
UPGRADABLE=$(printf '%s\n' "$PACKAGE_LIST" | awk 'NF { count++ } END { print count+0 }')

if [ "$UPGRADABLE" -eq 0 ]; then
    echo "APT OK - No packages to upgrade"
    exit 0
else
    printf 'APT WARNING - %s packages can be upgraded:\n%s\n' "$UPGRADABLE" "$PACKAGE_LIST"
    exit 1
fi
