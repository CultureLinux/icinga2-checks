#!/bin/bash

set -u
export LC_ALL=C

if [[ ! -r /etc/os-release ]]; then
    printf 'GITLAB UNKNOWN - Unable to read /etc/os-release\n'
    exit 3
fi

unset ID ID_LIKE
# shellcheck source=/dev/null
. /etc/os-release

packages=(gitlab-ce gitlab-ee)

case " ${ID:-} ${ID_LIKE:-} " in
    *" debian "*|*" ubuntu "*)
        if ! command -v apt >/dev/null || ! command -v dpkg-query >/dev/null; then
            printf 'GITLAB UNKNOWN - APT or dpkg-query is unavailable\n'
            exit 3
        fi
        installed_version=
        for package in "${packages[@]}"; do
            if package_info=$(dpkg-query -W -f='${db:Status-Status} ${Version}' "$package" 2>/dev/null) &&
                [[ $package_info == 'installed '* ]]; then
                installed_version=${package_info#installed }
                break
            fi
        done
        if [[ -z $installed_version ]]; then
            printf 'GITLAB UNKNOWN - No GitLab CE or EE package found installed\n'
            exit 3
        fi
        installed_version=${installed_version#*:}
        installed_version=${installed_version%%-*}
        if ! apt_output=$(apt list --upgradable "$package" 2>/dev/null); then
            printf 'GITLAB UNKNOWN - Unable to list APT upgrades\n'
            exit 3
        fi
        while IFS='/ ' read -r candidate _ version _; do
            if [[ $candidate == "$package" && -n $version ]]; then
                version=${version#*:}
                printf 'GITLAB CRITICAL - %s %s installed, update to %s available\n' \
                    "$package" "$installed_version" "${version%%-*}"
                exit 2
            fi
        done <<< "$apt_output"
        ;;
    *" rhel "*|*" fedora "*|*" centos "*)
        if ! command -v dnf >/dev/null || ! command -v rpm >/dev/null; then
            printf 'GITLAB UNKNOWN - DNF or RPM is unavailable\n'
            exit 3
        fi
        installed_version=
        for package in "${packages[@]}"; do
            if package_version=$(rpm -q --qf '%{VERSION}\n' "$package" 2>/dev/null); then
                installed_version=$package_version
                break
            fi
        done
        if [[ -z $installed_version ]]; then
            printf 'GITLAB UNKNOWN - No GitLab CE or EE package found installed\n'
            exit 3
        fi
        dnf_status=0
        dnf_error=$(dnf -y check-upgrade "$package" 2>&1 >/dev/null) || dnf_status=$?
        case "$dnf_status" in
            0) ;;
            100)
                printf 'GITLAB CRITICAL - Update available for %s (installed version %s)\n' \
                    "$package" "$installed_version"
                exit 2
                ;;
            *)
                printf 'GITLAB UNKNOWN - DNF check-upgrade failed (exit %s)%s\n' \
                    "$dnf_status" "${dnf_error:+: ${dnf_error//$'\n'/ }}"
                exit 3
                ;;
        esac
        ;;
    *)
        printf 'GITLAB UNKNOWN - Unsupported distribution (%s)\n' "${ID:-unknown}"
        exit 3
        ;;
esac

printf 'GITLAB OK - %s %s is up to date\n' "$package" "$installed_version"
