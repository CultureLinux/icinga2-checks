#!/bin/bash

WARNING=27
CRITICAL=10
if [[ $1 != '' && $2 != ''  ]]
then
  if ! tls_output=$(timeout -k 1s 10s openssl s_client -servername "$1" -connect "$1:$2" </dev/null 2>/dev/null) ||
      ! not_after=$(openssl x509 -inform pem -noout -enddate <<< "$tls_output" 2>/dev/null) ||
      [[ $not_after != notAfter=?* ]] ||
      ! expiry_epoch=$(LC_ALL=C date --date="${not_after#notAfter=}" +%s 2>/dev/null) ||
      ! now_epoch=$(date +%s); then
    printf 'UNKNOWN - Impossible de lire la date d’expiration pour %s:%s\n' "$1" "$2"
    exit 3
  fi
  day_diff=$(( (expiry_epoch - now_epoch)/(60*60*24) ))
  if [[ $day_diff -gt $WARNING ]]
  then
     echo "$day_diff jours restant pour $1:$2"
     exit 0
  elif [[  $day_diff -gt $CRITICAL ]]
  then
    echo "$day_diff jours restant pour $1:$2"
    exit 1
  else
    echo "$day_diff jours restant pour $1:$2"
    exit 2
  fi
else
  echo "usage: $0 <hostname> <port>"
  exit 3
fi
